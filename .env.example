# ==========================================
# Common Environment Configuration (Example)
# ==========================================

# Backend Configuration (Node.js / Express)
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/playnex_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=playnex_db

# Security & Tokens
JWT_SECRET=hackathon-playnex-access-secret-2026
JWT_REFRESH_SECRET=hackathon-playnex-refresh-secret-2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Configuration (Next.js / React)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="The Champions Club"
